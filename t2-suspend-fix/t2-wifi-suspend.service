[Unit]
Description=Unload BCM4377 Wi-Fi and Bluetooth around suspend
Documentation=https://github.com/austinsomer/omarchy-a2179-t2-bluetooth-suspend-fix
Before=sleep.target
StopWhenUnneeded=yes

[Service]
Type=oneshot
RemainAfterExit=yes
# pre can spend up to 20s cancelling an in-flight reload (the rebind can sit
# in an uninterruptible sysfs write) before it even starts unloading modules.
TimeoutStartSec=60
TimeoutStopSec=30
SyslogIdentifier=t2-wifi-suspend
ExecStart=/usr/local/sbin/t2-wifi-suspend pre
ExecStop=/usr/local/sbin/t2-wifi-suspend post

[Install]
WantedBy=sleep.target
